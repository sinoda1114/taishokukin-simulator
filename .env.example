TURSO_DATABASE_URL=file:./data/local.db
# TURSO_AUTH_TOKEN=
AUTH_PROVIDER=none

# 相談（サーバー専用）。値は書かない。NEXT_PUBLIC_ にはしない。
# GEMINI_API_KEY=

# 本番（Vercel → Settings → Environment Variables）
# Production と Preview の両方に入れる。Preview は別 DB でもよい。
# 値はダッシュボードにだけ置く。
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=
